[
  { "name": "no agent when nothing is set", "env": {}, "expected": null },

  { "name": "CURSOR_AGENT detected as cursor-cli", "env": { "CURSOR_AGENT": "1" }, "expected": "cursor-cli" },
  { "name": "empty CURSOR_AGENT is ignored", "env": { "CURSOR_AGENT": "" }, "expected": null },
  {
    "name": "CURSOR_EXTENSION_HOST_ROLE=agent-exec detected as cursor-cli",
    "env": { "CURSOR_EXTENSION_HOST_ROLE": "agent-exec" },
    "expected": "cursor-cli"
  },
  {
    "name": "CURSOR_EXTENSION_HOST_ROLE with another value is ignored",
    "env": { "CURSOR_EXTENSION_HOST_ROLE": "worker" },
    "expected": null
  },

  { "name": "AI_AGENT is used as the agent name", "env": { "AI_AGENT": "my-agent" }, "expected": "my-agent" },
  { "name": "AI_AGENT may include a version", "env": { "AI_AGENT": "devin@1.2" }, "expected": "devin@1.2" },
  { "name": "AI_AGENT is trimmed", "env": { "AI_AGENT": "  my-agent  " }, "expected": "my-agent" },
  {
    "name": "AI_AGENT takes priority over agent rules",
    "env": { "AI_AGENT": "my-agent", "CURSOR_AGENT": "1" },
    "expected": "my-agent"
  },
  { "name": "AI_AGENT with a newline is ignored", "env": { "AI_AGENT": "bad\nX-Injected: 1" }, "expected": null },
  { "name": "AI_AGENT with a space is ignored", "env": { "AI_AGENT": "bad agent" }, "expected": null },
  {
    "name": "AI_AGENT longer than 64 characters is ignored",
    "env": { "AI_AGENT": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    "expected": null
  },
  {
    "name": "invalid AI_AGENT falls through to agent rules",
    "env": { "AI_AGENT": "bad agent", "CURSOR_AGENT": "1" },
    "expected": "cursor-cli"
  },

  { "name": "AGENT=amp detected as amp", "env": { "AGENT": "amp" }, "expected": "amp" },
  { "name": "AGENT with another value is ignored", "env": { "AGENT": "other" }, "expected": null },
  { "name": "amp wins over the CLAUDECODE it also sets", "env": { "AGENT": "amp", "CLAUDECODE": "1" }, "expected": "amp" },
  { "name": "CLAUDE_CODE_IS_COWORK alone is not an agent", "env": { "CLAUDE_CODE_IS_COWORK": "1" }, "expected": null },
  {
    "name": "CLAUDE_CODE_IS_COWORK with CLAUDE_CODE detected as cowork",
